# TheHouse GenAI - example configuration only.
# Copy to .env for local use. Never commit real secrets.

# Runtime
APP_ENV=local                 # local | test | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
MAX_REQUEST_BYTES=65536
# Explicit origins only. Wildcards are rejected. Accepts JSON list or comma-separated values.
CORS_ORIGINS=[]

# Future LLM provider (spec 002). Not used by G01 foundation.
GENAI_PROVIDER=
GENAI_API_KEY=
GENAI_MODEL=
GENAI_TIMEOUT_SECONDS=15
GENAI_MAX_INPUT_CHARS=4000
