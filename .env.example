# TheHouse GenAI - example configuration only.
# Copy to .env for local use. Never commit real secrets.

# Runtime
APP_ENV=local                 # local | test | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
MAX_REQUEST_BYTES=65536
# Explicit origins only. Wildcards are rejected. Accepts JSON list or comma-separated values.
CORS_ORIGINS=[]

# LLM provider. Supported: fake, gemini.
# Gemini uses GEMINI_API_KEY (or GENAI_API_KEY) when GENAI_PROVIDER=gemini.
GENAI_PROVIDER=fake
GEMINI_API_KEY=
GENAI_API_KEY=
GENAI_MODEL=
GENAI_TIMEOUT_SECONDS=15
GENAI_MAX_INPUT_CHARS=4000
GENAI_MAX_OUTPUT_TOKENS=256
GENAI_MAX_OUTPUT_CHARS=1200
GENAI_MAX_RETRIES=2

# Service-to-service auth for generative endpoints (spec 003/005).
SERVICE_API_KEY=
