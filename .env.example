# TheHouse GenAI - example configuration only.
# Copy to .env for local use. Never commit real secrets.

# Runtime
APP_ENV=local                 # local | test | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
MAX_REQUEST_BYTES=65536
# In-process fixed-window rate limit for generative endpoints (spec 005). The state is
# per process: with N replicas the effective limit is N times these values.
GENAI_RATE_LIMIT_ENABLED=true
GENAI_RATE_LIMIT_REQUESTS=60
GENAI_RATE_LIMIT_WINDOW_SECONDS=60
GENAI_RATE_LIMIT_MAX_CLIENTS=1000
# Explicit origins only. Wildcards are rejected. Accepts JSON list or comma-separated values.
CORS_ORIGINS=[]

# Service-to-service credentials for the generative endpoints (spec 003, rotation in 005).
# Shared with TheHouse Backend and sent in the X-Service-Key header. Never commit values.
# Set the previous key only while rotating; leave it empty otherwise. Empty or blank
# values normalize to None. If GENAI_SERVICE_KEY is empty the service fails closed.
GENAI_SERVICE_KEY=
GENAI_SERVICE_KEY_PREVIOUS=

# LLM provider. "fake" is the offline test double; "gemini" calls the Gemini API
# (Google AI Studio). The factory only builds "fake" until spec 011 is closed.
GENAI_PROVIDER=fake
# Required when GENAI_PROVIDER=gemini: the API key. Never commit it.
GENAI_API_KEY=
# Required when GENAI_PROVIDER=gemini: the model id, chosen in AI Studio from the
# stable Flash family. There is no default in the repository.
GENAI_MODEL=
# Default 15 s (unchanged). Production (G09/G10, decision D18): set 6 s here and an
# 8 s timeout in the Backend client so GenAI cuts before the caller; a real peak of
# 9.6 s was observed on the free tier.
GENAI_TIMEOUT_SECONDS=15
GENAI_MAX_INPUT_CHARS=4000
